# Supabase project credentials — Project Settings → API in the Supabase dashboard.
# Copy this file to .env and fill in real values. Exact variable names matter:
# lib/supabase.ts reads these with non-null assertions and crashes at runtime if missing.

# Your project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase's "publishable" key = the anon/public key. Safe for the client (RLS protects data).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
